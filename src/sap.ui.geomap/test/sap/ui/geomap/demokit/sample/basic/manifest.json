{
  "sap.app": {
	"id": "sap.ui.geomap.sample.basic",
	"type": "application",
	"applicationVersion": {
	  "version": "1.0.0"
	}
  },
  "sap.ui5": {
	"handleValidation": true,
	"rootView": {
	  "viewName": "sap.ui.geomap.sample.basic.Main",
	  "type": "XML",
	  "async": true
	},
	"resources": {
	  "css": [
	    {
		  "uri": "style.css"
		}
	  ]
	},
	"dependencies": {
	  "libs": {
		"sap.m": {},
		"sap.ui.core": {},
        "sap.ui.geomap": {}
      }
	},
	"config": {
		"sample": {
			"files": [
				"manifest.json",
				"Component.js",
				"Main.controller.js",
				"Main.view.xml",
				"osm.json"
			],
			"settings": {
				"stretch": true
			}
		}
	}
  }
}
