{
	"name": "openui5",
	"version": "2.0.0-SNAPSHOT",
	"description": "OpenUI5 Core & Runtime",
	"private": true,
	"scripts": {
		"start": "npm run start --workspace src/testsuite --",
		"start-cli-next": "npm run start-cli-next --workspace src/testsuite --",
		"testsuite": "npm run testsuite --workspace src/testsuite",
		"testsuite-cli-next": "npm run testsuite-cli-next --workspace src/testsuite",
		"sdk": "npm run sdk --workspace src/testsuite",
		"build-sdk": "npm run build-sdk --workspace src/testsuite",
		"serve-sdk": "npm run serve-sdk --workspace src/testsuite",
		"update-jsdoc-template": "node lib/builder/updateTemplate.mjs",
		"test": "npm run lint",
		"lint": "eslint ./src --quiet --cache",
		"lint:styles": "stylelint \"src/**/*.less\"",
		"clean": "npm x --ws -c 'rimraf --verbose ./dist'",
		"link-all": "wsrun --serial link",
		"unlink-all": "wsrun --serial unlink",
		"generate-cldr": "cd lib/cldr-openui5 && npm start"
	},
	"keywords": [
		"openui5",
		"sapui5",
		"ui5"
	],
	"author": "SAP SE",
	"contributors": [
		"SAP SE <*@sap.com>"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/UI5/openui5.git"
	},
	"engines": {
		"node": "^20.17.0 || >=22.9.0",
		"npm": ">= 8"
	},
	"devDependencies": {
		"@stylistic/stylelint-plugin": "^5.1.0",
		"@ui5/builder": "^4.2.0",
		"@ui5/cli": "^4.0.57",
		"@ui5/cli-next": "npm:@ui5/cli@next",
		"@ui5/project": "^4.0.17",
		"@ui5/server": "^4.0.15",
		"async": "^3.2.6",
		"cheerio": "1.0.0",
		"cookie": "^2.0.0",
		"eslint": "^8.57.1",
		"http-proxy": "^1.18.1",
		"moment": "^2.30.1",
		"node-stream-zip": "^1.15.0",
		"postcss-less": "^6.0.0",
		"semver": "^7.8.4",
		"set-cookie-parser": "^3.1.0",
		"stylelint": "^17.13.0",
		"stylelint-config-standard": "^40.0.0",
		"wsrun": "^5.2.4"
	},
	"overrides": {
		"pacote": {
			"tar": "^7.5.15"
		}
	},
	"workspaces": [
		"src/*"
	]
}